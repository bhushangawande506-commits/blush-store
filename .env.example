# Blush Fashion E-Commerce Environment Configuration Template
# Copy this file to .env and replace the placeholder values with your secure credentials.

PORT=5000

# Razorpay Payment Gateway Credentials (Test or Live)
# Obtain credentials from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Admin Dashboard Access Key / Password
# Set a strong, secure passphrase for backend verification
ADMIN_KEY=your_secure_admin_password_here
